# =============================================================================
# Plantilla de Variables Locales; nunca subas terraform.tfvars a Git
# =============================================================================
# Copia este archivo a terraform.tfvars, aplica chmod 600 y completa tus valores.

# 1. API Token de Cherry Servers: Portal -> Settings -> API Keys
cherry_auth_token = "TU_API_TOKEN_AQUI"

# 2. ID numérico de tu proyecto en Cherry Servers: Portal -> Projects
project_id = 123456

# 3. Región geográfica: LT-Siauliai recomendada por costo y disponibilidad
region = "LT-Siauliai"

# 4. Plan de cómputo: Cloud VPS 1, 1 vCore, 1 GB RAM, 20 GB SSD, ~$0.015 EUR/hr
server_plan = "B1-1-1gb-20s-shared"

# 5. Sistema operativo base: CentOS Stream 10 de 64 bits
server_image = "centos_stream_10_64bit"

# 6. Nombre FQDN estructurado para el servidor
server_name = "0.ansible.linenes.tld"

# 7. Clave pública SSH Ed25519 obtenida con: cat ~/.ssh/id_ed25519.pub
ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... tu_correo@ejemplo.com"

# 8. Opcional: descomenta ssh_key_id si tu clave ya está registrada en Portal -> SSH Keys
# ssh_key_id = "20003"

# 9. Activar instancia Spot con descuento: true o false
spot_instance = false
